<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Audio input is the whole point of the application. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- PyInstaller apps use JIT-less Python but need unsigned-memory
       execution for some native extensions (ctranslate2, numpy). -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Outbound network is needed ONLY during field preparation. Field Offline
       makes no network calls regardless of this entitlement. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- The operator chooses where recordings and exports go. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
