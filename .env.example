# BabelFishR credentials - NAMES ONLY, no real values in this file.
#
# Copy to .env and fill in only what you actually use. Cloud engines are
# opt-in: with none of these set, BabelFishR runs entirely on this computer.
#
# On macOS you can store these in the Keychain instead of a file:
#   security add-generic-password -U -s BabelFishR -a ANTHROPIC_API_KEY -w
#
# .env is gitignored. Never commit a real key.

# Anthropic API key - used only by the optional Claude translation engine.
# Sends transcript TEXT (never audio) to the Anthropic API.
ANTHROPIC_API_KEY=

# Optional override for the Claude model used for translation.
# BABELFISHR_CLAUDE_MODEL=claude-opus-5
